<comment>
problem   = 2D Cylindrical Scalar Diffusion
reference =
configure = --prob=scalar_diff --coord=cylindrical --nscalars=1

<job>
problem_id = ScalarDiff   # problem ID: basename of output filenames

<output1>
file_type  = tab       # Tabular data dump
variable   = cons      # variables to be output
data_format = %24.16e
dt         = 1.0       # time increment between outputs

<time>
cfl_number  = 0.3       # The Courant, Friedrichs, & Lewy (CFL) Number
nlim        = -1        # cycle limit
tlim        = 0.5       # time limit (t0=0.5, tlim=0.5 => t=1.0)
integrator  = vl2       # time integration algorithm
xorder      = 2         # order of spatial reconstruction
ncycle_out  = 1         # interval for stdout summary info

<mesh>
nx1        = {{ case.refinement_value | int }}        # Number of zones in X1-direction
x1min      = 0.1       # minimum value of X1
x1max      = 1.0       # maximum value of X1
ix1_bc     = reflecting # inner-X1 boundary flag
ox1_bc     = reflecting # outer-X1 boundary flag

nx2        = {{ (2 * case.refinement_value) | int }}        # Number of zones in X2-direction
x2min      = 0.0       # minimum value of X2
x2max      = 6.283185307179586 # 2.0*PI
ix2_bc     = periodic  # inner-X2 boundary flag
ox2_bc     = periodic  # outer-X2 boundary flag

nx3        = 1         # Number of zones in X3-direction
x3min      = -0.5      # minimum value of X3
x3max      = 0.5       # maximum value of X3
ix3_bc     = periodic  # inner-X3 boundary flag
ox3_bc     = periodic  # outer-X3 boundary flag

num_threads = 1        # maximum number of OMP threads
refinement  = none

<meshblock>
nx1        = {{ case.refinement_value | int }}
nx2        = {{ (2 * case.refinement_value) | int }}
nx3        = 1

<hydro>
gamma = 1.666666666666667 # gamma = C_p/C_v
iso_sound_speed = 1.0     # isothermal sound speed

<problem>
iprob         = 1       # 2D diffusion
amp           = 1.0e-6  # Wave Amplitude
t0            = 0.5     # Initial time offset
nu_scalar_iso = 0.001    # Scalar diffusion coefficient
x10           = 0.5     # Center of Gaussian
x20           = 0.5     # Center of Gaussian
