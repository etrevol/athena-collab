<comment>
problem   = M6 -- mass budget of the torus over 5 orbits
configure = --prob=acc_disk_visc_vv --coord=cylindrical
generated = rendered by vvkit from athinput.equilibrium.template

# One orbit, inviscid (alpha = 0 AND nu_iso = 0 -- nu_iso > 0 with alpha = 0 is not
# inviscid, it applies a constant nu). The torus is a stationary solution, so whatever
# separates rho(r, t = P_orb) from the analytic profile is the scheme's own error.
#
# Square mesh in index space: vvkit derives every coordinate's cell width from the single
# refinement value, so nx2 != nx1 corrupts the cell measures and the cell averages.

<job>
problem_id = acc_disk_visc

<output1>
file_type   = tab         # output format
variable    = prim        # rho, press, vel1, vel2, vel3
dt          = 0.100358    # one dump per orbit
data_format = %24.16e     # output format specifier

<output3>
file_type   = hst         # history: the time series the budget is computed from
dt          = 0.00200715  # 10 samples per orbit
data_format = %24.16e     # output format specifier

<time>
cfl_number = 0.4         # Courant, Friedrichs & Lewy number
nlim       = -1          # cycle limit (-1 = unlimited)
tlim       = 0.1003575    # five orbital periods
integrator = vl2         # time integration algorithm
xorder     = 2           # order of spatial reconstruction
ncycle_out = 1000000     # interval for stdout summary info

<mesh>
nx1    = {{ case.refinement_value | int }}   # number of zones in X1-direction
x1min  = 0.35          # minimum value of X1
x1max  = 5.55          # maximum value of X1
x1rat  = 1.0           # ratio of adjacent cell widths in X1
ix1_bc = user          # inner-X1 boundary condition flag
ox1_bc = user          # outer-X1 boundary condition flag

nx2    = {{ case.refinement_value | int }}   # number of zones in X2-direction
x2min  = 0.0           # minimum value of X2
x2max  = 6.28318530718 # maximum value of X2
ix2_bc = periodic      # inner-X2 boundary condition flag
ox2_bc = periodic      # outer-X2 boundary condition flag

nx3    = 1             # number of zones in X3-direction
x3min  = -0.5          # minimum value of X3
x3max  = 0.5           # maximum value of X3
ix3_bc = periodic      # inner-X3 boundary condition flag
ox3_bc = periodic      # outer-X3 boundary condition flag

<meshblock>
nx1 = {{ case.refinement_value | int }}   # MeshBlock size in X1-direction
nx2 = {{ case.refinement_value | int }}   # MeshBlock size in X2-direction
nx3 = 1             # MeshBlock size in X3-direction

<hydro>
gamma  = 1.3333333333333333  # ratio of specific heats
dfloor = 1e-12         # density floor
pfloor = 1e-10         # pressure floor

<problem>
r_center = 1.0         # radius of the disk density maximum
C_prime  = 0.2         # disk thickness parameter (0 < C_prime < 0.5)
nu_iso   = 0           # isotropic kinematic viscosity; > 0 enables viscous fluxes
alpha    = 0           # Shakura-Sunyaev viscosity parameter

rho_atm      = 0.0001  # ambient medium density
t_atm_frac   = 1       # ambient p/rho, in units of the disk mid-plane value
visc_rho_cut = 0.001   # density below which viscosity is tapered to zero

pert_amp     = 0       # seed delta v_r, in units of the local sound speed (0 = off)
pert_kind    = single  # single | multi | noise
pert_m       = 2       # azimuthal mode number (single), or highest mode (multi)
pert_seed    = 1       # seed integer; the perturbation field depends on it alone

M_bh     = 4.5e+07     # black hole mass [M_sun]
rho_0    = 1e-13       # reference density [g/cm^3]
T_0      = 50000       # reference temperature [K]
mu       = 0.6         # mean molecular weight
chi      = 500         # spatial scaling factor r_0 / r_g
