<comment>
problem   = Thermally-scaled Papaloizou-Pringle accretion disk with alpha viscosity
configure = --prob=acc_disk_visc --coord=cylindrical
generated = scripts/theory/make_athinput.py

<job>
problem_id = acc_disk_visc   # prefix of every output file

<output1>
file_type  = tab         # primitive variables (rho, press, vel1..3)
variable   = prim
dt         = 0.00101227  # output interval, 10 frames per orbit
dcycle     = -1          # cycle-based output disabled

<output2>
file_type  = tab         # user variables: f_grav, f_centr, f_press, f_sum
variable   = uov
dt         = 0.00101227  # output interval
dcycle     = -1          # cycle-based output disabled

<output3>
file_type  = hst         # global time series (mass, energy, disk_mass, mdot_in)
dt         = 0.00101227  # output interval
dcycle     = -1          # cycle-based output disabled
data_format = %24.16e    # 6 digits is too few: disk_mass varies in the 5th

<time>
cfl_number = 0.4         # Courant number
nlim       = -1          # no cycle limit
tlim       = 1.01227     # stop time, 100 orbits of P_orb = 0.0101227
integrator = vl2         # Van Leer predictor-corrector, 2nd order
xorder     = 2           # piecewise linear reconstruction
ncycle_out = 50          # console progress interval

<mesh>
nx1    = 176           # radial cells, dr = 0.0295455
x1min  = 0.35          # inner edge, must be < r_in = 0.563508 (7 cells of margin)
x1max  = 5.55          # outer edge, must be > r_out = 4.43649 (37 cells of margin)
x1rat  = 1.0           # uniform radial spacing
ix1_bc = user          # diode outflow, v_phi extrapolated as r^(-1/2)
ox1_bc = user          # diode outflow, v_phi extrapolated as r^(-1/2)

nx2    = 128           # azimuthal cells over the full 2*pi
x2min  = 0.0           # phi lower bound
x2max  = 6.28318530718 # phi upper bound, 2*pi
ix2_bc = periodic      # periodic in phi
ox2_bc = periodic      # periodic in phi

nx3    = 1             # 2D run in the equatorial plane
x3min  = -0.5          # z lower bound
x3max  = 0.5           # z upper bound, slab of unit height
ix3_bc = periodic      # unused in 2D
ox3_bc = periodic      # unused in 2D

<meshblock>
nx1 = 176           # MeshBlock radial size
nx2 = 128           # MeshBlock azimuthal size
nx3 = 1             # MeshBlock vertical size

<hydro>
gamma  = 1.3           # adiabatic index
dfloor = 1e-12         # density floor, a safety net only, 1e+08x below rho_atm
pfloor = 1e-10         # pressure floor, a safety net only

<problem>
r_center = 1.0         # radius of the density maximum
C_prime  = 0.2         # torus thickness parameter, must be < 0.5
nu_iso   = 1           # enables viscosity; value overwritten by DiskViscosity
alpha    = 0.001       # Shakura-Sunyaev alpha; needs nu_iso > 0 to take effect

rho_atm      = 0.0001  # ambient density; >= 1e-4 required whenever alpha > 0
t_atm_frac   = 1       # ambient p/rho in units of the torus mid-plane value
visc_rho_cut = 0.001   # viscosity tapers to zero below this density

M_bh     = 4.5e+07     # black hole mass [M_sun]
rho_0    = 1e-13       # reference density [g/cm^3]
T_0      = 50000       # reference temperature [K]
mu       = 2.3         # mean molecular weight
chi      = 500         # spatial scaling r_0 / r_g

