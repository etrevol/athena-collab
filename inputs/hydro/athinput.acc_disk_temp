<comment>
problem   = Thermally-Scaled Papaloizou-Pringle Accretion Disk with Spatially-Varying Viscosity
configure = --prob=acc_disk_temp_visc --coord=cylindrical

<job>
problem_id = acc_disk_visc

<output1>
file_type  = tab        # Table output format for 1D/2D diagnostics
variable   = prim       # Output primitive variables (rho, v, p)
dt         = 8.92244e-04      # Output timestep
dcycle     = -1         # Disable cycle-based output

<time>
cfl_number = 0.4        # Strict CFL for stability during viscous shearing
nlim       = -1         # No cycle limit
tlim       = 8.92244e-01      # Total simulation duration (acoustic time units)
integrator = vl2        # Van Leer predictor-corrector (2nd order)
xorder     = 2          # Piecewise linear reconstruction
ncycle_out = 50         # Console output frequency

<mesh>
# Radial direction (x1 = r)
nx1    = 64            # Increased radial resolution for better shock capturing
x1min  = 0.01            # Inner boundary (should be << r_inner)
x1max  = 7            # Outer boundary (should be >> r_outer)
x1rat  = 1.0            # Uniform spacing
ix1_bc = outflow        # Accretion sink at the inner boundary
ox1_bc = outflow        # Free outflow at the outer boundary

# Azimuthal direction (x2 = phi)
nx2    = 64            # Azimuthal resolution for 2D mode growth
x2min  = 0.0            
x2max  = 6.28318530718  # 2*pi
ix2_bc = periodic       
ox2_bc = periodic

# Vertical direction (x3 = z)
nx3    = 1              # 2D Simulation (equatorial plane)
x3min  = -0.5
x3max  = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 64                # MeshBlock size (for MPI parallelization)
nx2 = 64                # Recommended: 32-64 cells per dimension
nx3 = 1

<hydro>
gamma  = 1.01  # Adiabatic index
dfloor = 1.0e-8         # Density vacuum floor
pfloor = 1.0e-10        # Pressure vacuum floor

<problem>
# Geometric configuration
r_center = 1.0          # Dimensionless location of the disk center (R_0/r_0)
C_prime  = 0.4          # Geometric thickness parameter (< 0.5)
nu_iso   = 0.0          # Kinematic viscosity (set > 0 to enable viscous transport)

# Physical properties for thermal scaling (CGS)
T_0      = 5.00e+04          # Reference temperature in Kelvin (e.g., 1 million K for inner AGN)
mu       = 2.3          # Mean molecular weight
chi      = 5.00e+02          # Spatial scaling parameter (r_0 / r_g)

